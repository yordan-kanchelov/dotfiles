#!/usr/bin/env zsh

# ============================================
# CORE ZSH CONFIGURATION
# Interactive shell settings: plugins, prompt, aliases, functions
# Environment setup is in .zprofile
# ============================================

# Increase function nesting limit
FUNCNEST=1000

# ============================================
# HISTORY
# Atuin has its own DB; this feeds zsh-autosuggestions
# ============================================
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt inc_append_history hist_ignore_dups hist_ignore_space

# ============================================
# PLUGIN MANAGER (sheldon)
# ============================================
eval "$(sheldon source)"

# ============================================
# COMPLETIONS
# ============================================
autoload -Uz compinit
# -u skips compaudit permission checks (single-user machine, no need).
# The (#q...) glob qualifier only expands under extendedglob — without it the
# test is a literal non-empty string, always true, and every shell start pays
# the full dump rebuild. Anonymous function keeps the setopt local.
() {
  setopt localoptions extendedglob
  if [[ -n ${HOME}/.zcompdump(#qN.mh+24) ]]; then
    compinit -u
  else
    compinit -C
  fi
}

# ============================================
# INTERACTIVE TOOL INITIALIZATIONS
# ============================================
# fzf and atuin must init after zsh-vi-mode finishes recreating keymaps,
# otherwise their bindings get overwritten. Use array form so multiple
# hooks can compose; fall back to direct init if plugin not loaded.
# `fzf --zsh` arrived in fzf 0.48. Debian/Ubuntu still ship 0.44, where it
# aborts startup with "unknown option: --zsh" and silently costs us Ctrl-T and
# Alt-C, so fall back to the integration scripts older packages do install.
# Homebrew is not exempt: the playbook installs formulae with state: present,
# which never upgrades an fzf that predates the flag. Each layout keeps the
# scripts somewhere else -- Debian as doc examples, Homebrew in the opt prefix.
_init_fzf() {
  if fzf --zsh >/dev/null 2>&1; then
    source <(fzf --zsh)
    return 0
  fi
  local -a dirs=(/usr/share/doc/fzf/examples)
  # .zprofile's shellenv exports HOMEBREW_PREFIX; only shell out to brew when a
  # non-login shell left it unset, and only here, where the flag already failed.
  local prefix=${HOMEBREW_PREFIX:-$(command -v brew >/dev/null && brew --prefix)}
  [[ -n $prefix ]] && dirs+=("$prefix/opt/fzf/shell")
  local dir
  for dir in $dirs; do
    [[ -f $dir/key-bindings.zsh || -f $dir/completion.zsh ]] || continue
    [[ -f $dir/key-bindings.zsh ]] && source $dir/key-bindings.zsh
    [[ -f $dir/completion.zsh ]] && source $dir/completion.zsh
    break
  done
  return 0
}

if [[ -n ${zvm_after_init_commands+x} ]]; then
  zvm_after_init_commands+=('_init_fzf; eval "$(atuin init zsh)"')
else
  _init_fzf
  eval "$(atuin init zsh)"
fi
eval "$(starship init zsh)"
eval "$(zoxide init zsh)"

# ============================================
# ALIASES
# ============================================
alias lg='lazygit'
alias ghcs='gh copilot suggest'
alias ta="tmux attach-session -t"
alias tn="tmux new -s"
alias tls="tmux list-sessions"
alias tk="tmux kill-session -t"
alias tkill="tmux kill-server"
alias tren="tmux rename-session -t"
alias tnw="tmux new-window"
alias th="tmux split-window -h"
alias tv="tmux split-window -v"
# alias tkp="tmux kill-pane"
alias tkp="exit"
alias vim="nvim"
alias ':q'='exit'
alias l='eza -l -b --all --header --git --icons --group-directories-first'
alias ls='eza -l -b --all --header --git --icons --group-directories-first'
alias cleanc='clean_dev_caches'
alias cleanp='clean_project'
alias supd='sheldon lock --update'
alias sw='sync-worktrees'
alias c='claude -c'

# ============================================
# FUNCTIONS
# ============================================
clean_dev_caches() {
  echo "Cleaning npm cache..."
  npm cache clean --force
  echo "Pruning pnpm store..."
  pnpm store prune
  echo "Caches cleaned and pruned!"
  printf "Run 'docker system prune -f --volumes'? This deletes stopped containers AND their volumes [y/N] "
  read -r reply
  if [[ "$reply" =~ ^[Yy]$ ]]; then
    docker system prune -f --volumes
    echo "Docker cache cleaned!"
  else
    echo "Skipped Docker prune."
  fi
}

clean_project() {
    setopt local_options no_monitor no_notify
    echo "Cleaning project files..."
    local count=0

    while IFS= read -r item; do
        echo "  Removing: $item"
        rm -rf "$item" &
        ((count++))
        (( count % 4 == 0 )) && wait
    done < <(
        find . -type d \( -name node_modules -o -path '*/.nx/cache' \) -prune -print 2>/dev/null
    )
    wait

    while IFS= read -r item; do
        echo "  Removing: $item"
        rm -rf "$item" &
        ((count++))
        (( count % 4 == 0 )) && wait
    done < <(
        find . \
            -type d \( -name dist -o -name release -o -name dist-electron \) -prune -print \
            -o -type f \( -name pnpm-lock.yaml -o -name package-lock.json \) -print \
            2>/dev/null
    )
    wait

    if [[ $count -eq 0 ]]; then
        echo "  No files found to remove"
    else
        echo "  Removed $count items"
    fi
}

y() {
  local tmp cwd
  tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
  trap 'rm -f -- "$tmp"' EXIT INT TERM
  command yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd < "$tmp"
  [ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
  trap - EXIT INT TERM
  rm -f -- "$tmp"
}

fvim() {
  local selected_file
  selected_file=$(fzf --preview="bat --color=always {}" --bind "esc:abort")
  if [ -n "$selected_file" ]; then
    nvim "$selected_file"
  fi
}

cat() {
  # When piped or redirected, behave like plain cat to avoid bat's pager/color escapes
  if [ ! -t 1 ]; then
    command cat "$@"
    return
  fi
  if [ $# -eq 0 ]; then
        command bat
        return
    fi
    local file="$1"
    if [ ! -f "$file" ]; then
        command bat "$@"
        return
    fi
    local mime=$(file --mime-type -b "$file" 2>/dev/null)
    case "$mime" in
        image/*)
            local term_width=$(tput cols)
            viu -w $((term_width - 2)) "$@"
            ;;
        application/pdf)
            if command -v termpdf &> /dev/null; then
                termpdf "$file"
            elif command -v pdftotext &> /dev/null; then
                pdftotext -layout "$file" - | command bat -l txt
            else
                echo "Install pdftotext or termpdf for better PDF viewing"
                command bat "$@"
            fi
            ;;
        video/*)
            if command -v ffmpeg &> /dev/null; then
                ffmpeg -i "$file" -ss 00:00:01.000 -vframes 1 -f image2pipe -vcodec png - 2>/dev/null | viu -
            else
                echo "Install ffmpeg to preview videos"
            fi
            ;;
        *)
            case "${file:l}" in
                *.md|*.markdown)
                    if command -v glow &> /dev/null; then
                        glow "$file"
                    else
                        command bat "$@"
                    fi
                    ;;
                *)
                    command bat "$@"
                    ;;
            esac
            ;;
    esac
}

clear() {
  command clear
  if [[ -n $TMUX ]]; then
    tmux clear-history
  fi
}

# Quick reload of zsh configuration (exec avoids double plugin init from re-sourcing)
alias reload='exec zsh'

# Pin a per-pane session id so tmux-resurrect restores each pane into its own
# conversation. Bare `claude` -> mint a new id. Resurrect re-types
# `claude --session-id <uuid>`; if that transcript already exists, resume it
# (claude itself only resumes via --resume, not --session-id). Anything else passes
# through (c/-c, -r, -p, subcommands like `claude mcp`).
claude() {
  if [[ "$1" == "--session-id" && -n "$2" ]]; then
    local id="$2"; local existing=(~/.claude/projects/*/"$id".jsonl(N))
    if (( ${#existing} )); then shift 2; command claude --resume "$id" "$@"; return; fi
  elif [[ $# -eq 0 ]]; then
    set -- --session-id "$(uuidgen | tr '[:upper:]' '[:lower:]')"
  fi
  command claude "$@"
}
