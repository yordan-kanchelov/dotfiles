# Native Windows configuration; Ubuntu is available in the profile picker.
font-family = 0xProto Nerd Font
font-size = 14
theme = Catppuccin Macchiato
command = pwsh.exe -NoLogo -ExecutionPolicy RemoteSigned
background-opacity = 0.9
mouse-hide-while-typing = true
cursor-style = block
cursor-style-blink = false
window-padding-x = 8
window-padding-y = 8
scrollback-limit = 10000
keybind = shift+enter=text:\n
