# Mouse side buttons -> macOS-style window overviews (Cinnamon/X11).
# X numbers these 8/9; the mouse itself calls them 4/5. Swap the two blocks
# if your thumb disagrees.
#
# Both fire on Release, not press. A press-bound mouse grab fires several times
# for one physical click (measured: 7 fires from 3 clicks), which toggles the
# overview straight back shut and spawns duplicate rofi processes.

# Button 4 / X8 ("Button Side", back) -> Mission Control: all windows (Cinnamon Scale)
"$HOME/.local/bin/mission-control"
  Release + b:8

# Button 5 / X9 ("Button Extra", forward) -> App Exposé: windows of the focused app
"$HOME/.local/bin/app-expose"
  Release + b:9

# Rectangle-style window tiling on Ctrl+Super. Rectangle's own Ctrl+Alt is taken
# here: the arrows switch workspace and Ctrl+Alt+T opens a terminal. Ctrl+Super
# is unbound across the whole gsettings tree, so nothing has to be surrendered.
#
# Each quoted argument is one "X Y W H" position; repeating the binding steps to
# the next one and wraps, the way Rectangle cycles. The keys that lead a group
# (Left/Right/Up/Down, D, E, U, Z, X) walk the whole group; F, G, I, J, K and T
# stay direct jumps, since the leaders already reach those spots.
#
# Halves duplicate Cinnamon's native Super+arrows on purpose — same muscle memory
# as macOS, and the native ones keep working.

# Halves, cycling 1/2 -> 2/3 -> 1/3
"$HOME/.local/bin/tile '0 0 .5 1' '0 0 .66667 1' '0 0 .33333 1'"
  Control+Mod4 + Left
"$HOME/.local/bin/tile '.5 0 .5 1' '.33333 0 .66667 1' '.66667 0 .33333 1'"
  Control+Mod4 + Right
"$HOME/.local/bin/tile '0 0 1 .5' '0 0 1 .66667' '0 0 1 .33333'"
  Control+Mod4 + Up
"$HOME/.local/bin/tile '0 .5 1 .5' '0 .33333 1 .66667' '0 .66667 1 .33333'"
  Control+Mod4 + Down

# Quarters: U walks them clockwise, I/J/K jump straight to one
"$HOME/.local/bin/tile '0 0 .5 .5' '.5 0 .5 .5' '.5 .5 .5 .5' '0 .5 .5 .5'"
  Control+Mod4 + u
"$HOME/.local/bin/tile '.5 0 .5 .5'"
  Control+Mod4 + i
"$HOME/.local/bin/tile '0 .5 .5 .5'"
  Control+Mod4 + j
"$HOME/.local/bin/tile '.5 .5 .5 .5'"
  Control+Mod4 + k

# Thirds: D walks first -> center -> last, F and G jump straight there
"$HOME/.local/bin/tile '0 0 .33333 1' '.33333 0 .33333 1' '.66667 0 .33333 1'"
  Control+Mod4 + d
"$HOME/.local/bin/tile '.33333 0 .33333 1'"
  Control+Mod4 + f
"$HOME/.local/bin/tile '.66667 0 .33333 1'"
  Control+Mod4 + g

# Two thirds: E walks first -> last, T jumps to the last one
"$HOME/.local/bin/tile '0 0 .66667 1' '.33333 0 .66667 1'"
  Control+Mod4 + e
"$HOME/.local/bin/tile '.33333 0 .66667 1'"
  Control+Mod4 + t

# Sixths (3x2 grid). Z starts top right and runs each row right to left, top row
# first; X is its mirror — bottom left, each row left to right, bottom row first.
"$HOME/.local/bin/tile '.66667 0 .33333 .5' '.33333 0 .33333 .5' '0 0 .33333 .5' '.66667 .5 .33333 .5' '.33333 .5 .33333 .5' '0 .5 .33333 .5'"
  Control+Mod4 + z
"$HOME/.local/bin/tile '0 .5 .33333 .5' '.33333 .5 .33333 .5' '.66667 .5 .33333 .5' '0 0 .33333 .5' '.33333 0 .33333 .5' '.66667 0 .33333 .5'"
  Control+Mod4 + x

# Centre the window without resizing it
"$HOME/.local/bin/tile 'center'"
  Control+Mod4 + c

# Maximize
"$HOME/.local/bin/tile '0 0 1 1'"
  Control+Mod4 + Return
