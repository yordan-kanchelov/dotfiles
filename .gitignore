**/.DS_Store*

# Secrets and environment files
.secrets
.secrets.*
.env
.env.*
*_local.sh

# Local backups and temporary files
.tmp/

# This repo IS the source of these files, but the user's global gitignore
# ignores CLAUDE.md everywhere — re-include the one we deliberately track.
!claude/CLAUDE.md

# AI tool machine state — must never be committed even if copied in by accident
auth.json
.credentials*
settings.local.json
*.sqlite*
history*
sessions/
shell-snapshots/
shell_snapshots/

# Agent worktree scratch state
.claude/worktrees/

# Claude Code syncs Anthropic-authored skills into ~/.claude/skills, which the
# symlinks task points at this directory — so they land inside the repo. They
# are re-fetched on demand; only skills we author here belong in git.
claude/skills/synced/
claude/skills/session-start-hook/
