--- a/headroom/settings_store.py
+++ b/headroom/settings_store.py
@@ -30,0 +31,3 @@
+
+# Settings loaded at startup are not explicit operator exports.
+_FILE_SEEDED_ENV_VALUES: dict[str, str] = {}
@@ -1008 +1011,13 @@
-        os.environ.setdefault(field.env, _serialize(field, value))
+        if field.env not in os.environ:
+            serialized = _serialize(field, value)
+            os.environ[field.env] = serialized
+            _FILE_SEEDED_ENV_VALUES[field.env] = serialized
+
+
+def child_environ() -> dict[str, str]:
+    """Let child CLIs reload file settings without treating them as exports."""
+    return {
+        key: value
+        for key, value in os.environ.items()
+        if _FILE_SEEDED_ENV_VALUES.get(key) != value
+    }
@@ -1098 +1113,2 @@
-                and field.env not in env_override_exclusions,
+                and field.env not in env_override_exclusions
+                and os.environ.get(field.env) != _FILE_SEEDED_ENV_VALUES.get(field.env),
