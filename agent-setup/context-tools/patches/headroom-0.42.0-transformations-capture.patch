+
+def _request_projection(body: Any) -> list[dict[str, Any]]:
+    if isinstance(body, (str, bytes)):
+        try:
+            body = json.loads(body)
+        except (ValueError, UnicodeDecodeError):
+            return []
+    if not isinstance(body, dict):
+        return []
+    if isinstance(body.get("response"), dict):
+        body = body["response"]
+    content = {key: body[key] for key in ("instructions", "input", "messages", "system", "tools")
+               if key in body}
+    return [deepcopy(content)] if content else []
+
+
+@dataclass
+class RequestSnapshots:
+    before: list[dict[str, Any]]
+    after: list[dict[str, Any]] | None = None
+
+    @classmethod
+    def capture(cls, enabled: bool, original: Any) -> RequestSnapshots | None:
+        # Do not parse or copy payloads while content logging is disabled.
+        return cls(_request_projection(original)) if enabled else None
+
+    def set_sent(self, body: Any) -> None:
+        self.after = _request_projection(body)
+
+    def apply(self, outcome: RequestOutcome) -> RequestOutcome:
+        return replace(outcome, request_messages=self.before, compressed_messages=self.after)
+
+
+class RequestSnapshotQueue:
+    """Bind sent request snapshots to the provider's response IDs."""
+
+    def __init__(self) -> None:
+        self.pending: deque[RequestSnapshots] = deque()
+        self.active: dict[str, RequestSnapshots] = {}
+        self.disabled = False
+
+    def enqueue(self, pair: RequestSnapshots | None) -> None:
+        if pair is None or self.disabled:
+            return
+        if len(self.pending) + len(self.active) >= 100:
+            self.pending.clear()
+            self.active.clear()
+            # shortcut: stop snapshots after overflow; reconnect to resume safely.
+            self.disabled = True
+            return
+        self.pending.append(pair)
+
+    def event(self, event: Any) -> RequestSnapshots | None:
+        if self.disabled or not isinstance(event, dict):
+            return None
+        kind = event.get("type")
+        response = event.get("response")
+        response_id = response.get("id") if isinstance(response, dict) else None
+        response_id = response_id or event.get("response_id")
+        response_id = response_id if isinstance(response_id, str) else None
+        if kind == "response.created":
+            if response_id and response_id not in self.active and self.pending:
+                self.active[response_id] = self.pending.popleft()
+        elif kind == "response.completed":
+            return self.active.pop(response_id, None)
+        elif kind in {"error", "response.cancel", "response.cancelled",
+                      "response.failed", "response.incomplete"}:
+            if response_id in self.active:
+                self.active.pop(response_id)
+            else:
+                # An uncorrelated rejection must not shift later FIFO matches.
+                self.pending.clear()
+                self.active.clear()
+                self.disabled = True
+        return None
